{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NuviraHub",
  "identifier": "io.github.alexbn71.nuvira",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NuviraHub",
        "width": 900,
        "height": 640,
        "minWidth": 520,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
